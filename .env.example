GRPC_ENDPOINT=https://your-yellowstone-endpoint:443
GRPC_TOKEN=your-x-token-here
WALLET_KEYPAIR_PATH=/Users/you/.config/solana/id.json
RPC_URL=https://api.mainnet-beta.solana.com
POOLS_CONFIG_PATH=pools.json

# ── Base token ────────────────────────────────────────────────────────────────
# Starting/closing token of every arbitrage cycle. Default = wrapped SOL.
# Supported: SOL (So11111111111111111111111111111111111111112)
#            USDC (EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v)
# When set to a non-native base (USDC), flash loan is force-disabled (wallet-funded
# only) and the wallet must hold USDC capital AND SOL for gas/tips.
# BASE_MINT=So11111111111111111111111111111111111111112

# Thresholds are in the BASE TOKEN's smallest unit (SOL=9 decimals, USDC=6 decimals).
# The historical SOL-named vars still work; the *_BASE_UNITS aliases are base-neutral.
# USDC examples (6 decimals): MIN_PROFIT_BASE_UNITS=20000 (0.02 USDC), INPUT_BASE_UNITS=100000000 (100 USDC)

# Halt if native SOL falls below this floor (can't pay tips/fees). Enforced only when
# BASE_MINT is non-native; for a SOL base the P&L guard already covers gas. Default 0.1 SOL.
# MIN_SOL_GAS_LAMPORTS=100000000

# Arbitrage parameters
MIN_PROFIT_LAMPORTS=10000          # alias: MIN_PROFIT_BASE_UNITS
INPUT_SOL_LAMPORTS=100000000       # alias: INPUT_BASE_UNITS
SLIPPAGE_BPS=50
# Maximum price impact per hop in bps (100 = 1%). Rejects pools too small for the trade.
MAX_PRICE_IMPACT_BPS=100
# Maximum cycle length searched (2 or 3, default 3). 2 skips the O(E³) 3-hop
# enumeration — cheaper hot loop; only 2-hop cycles qualify for raw-RPC anyway.
#MAX_ARB_HOPS=3

# Reject any cycle whose stalest leg's last live gRPC update is older than this (ms).
# Prevents submitting phantom cycles built on stale edges (they fail Jito Block Engine
# simulation and drop regardless of tip). 0 = disabled. Fresh legs update in 0-50ms.
MAX_CYCLE_STALENESS_MS=2000

# Backfill poller: RPC-refresh pools the gRPC feed leaves stale (free/shared feeds
# throttle large subscriptions). Polls only stale pools (batched getMultipleAccounts,
# max 10 pools/tick); fresh pools cost nothing. Keep threshold < MAX_CYCLE_STALENESS_MS
# so pools refresh before the gate fires. Jupiter/DAMM pools are not backfillable.
STALE_POLL_ENABLE=true
STALE_POLL_INTERVAL_MS=400
STALE_POLL_THRESHOLD_MS=1500

# Jito tip: 0.0 = 0%, 0.5 = 50% of gross profit goes to tip
TIP_RATIO=0.51
MAX_TIP_LAMPORTS=1000000

# Reject cycles whose tip is below MIN_TIP_LAMPORTS (absolute, 0 = off).
# MIN_TIP_LAMPORTS=5000000

# Reject cycles whose tip is below tip_floor × this multiple (0.0 = off).
# Competition typically bids 2000–5000× the floor on active blocks.
# A value of 500 filters clearly uncompetitive cycles before any submission attempt.
# MIN_TIP_FLOOR_MULTIPLE=0.0

# Set to true to log bundles without submitting
DRY_RUN=true

# Set to true to skip pre-submission simulation and submit bundles directly to Jito.
# Reduces latency at the cost of occasionally paying base fees on failed bundles.
# DISABLE_SIMULATION=false

# Set to true to fund arb capital via a MarginFi flash loan (~9 bps fee) instead of
# the wallet balance. Allows running with minimal SOL — wallet still needs ~0.1 SOL
# for tx fees and Jito tips, but not for swap capital.
# When active, INPUT_SOL_LAMPORTS is ignored. The ternary search finds the
# slippage-optimal input within [0.001 SOL, FLASH_LOAN_MAX_INPUT_SOL_LAMPORTS].
# Requires MARGINFI_ACCOUNT, MARGINFI_SOL_BANK_ORACLE (group + bank have mainnet defaults).
# Strongly recommended: also set DISABLE_SIMULATION=true when flash loan is active.
# ENABLE_FLASH_LOAN=false
# FLASH_LOAN_MAX_INPUT_SOL_LAMPORTS=50000000000    # 50 SOL cap; ternary search finds true optimum within this
# MARGINFI_ACCOUNT=<your-marginfi-lending-account-pubkey>
# MARGINFI_GROUP=4qp6Fx6tnZkY5Wropq9wUYgtFxXKwE6viZxFHg3rdAG5
# MARGINFI_SOL_BANK=CCKtUs6Cgwo4aaQUmBPmyoApH2gUDErxNZCAntD6LYGh
# MARGINFI_SOL_BANK_ORACLE=<pyth-or-switchboard-sol-usd-feed-for-this-bank>

# tracing filter: info, debug, warn
RUST_LOG=solana_mev=info

# ── Portfolio watcher (run as: ./portfolio-watcher) ───────────
PORTFOLIO_PATH=assets/portfolio.json
HISTORY_PATH=assets/price_history.jsonl

# Birdeye API key (free signup at birdeye.so) — used to backfill price history on first run
BIRDEYE_API_KEY=your-birdeye-api-key

# Alert thresholds
ALERT_PCT_5M=3.0     # email if any asset moves ±3% in 5 minutes
ALERT_PCT_1H=10.0    # email if any asset moves ±10% in 1 hour
ALERT_COOLDOWN_MIN=30

# Recipient email for opportunity alerts
ALERT_EMAIL=you@example.com

# SMTP credentials (e.g. Gmail app password, smtp.gmail.com:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com

# ── Momentum trader (portfolio-watcher; off by default) ────────────────────────
# Buys the strongest watched token (Sortino) with USDC, rides it, trail-stops back
# to USDC. Independent of the arb bot and of ENABLE_JUPITER — it uses the public
# Jupiter REST endpoint below and needs NO Metis binary. See docs/portfolio/momentum-trader.md.
# ENABLE_MOMENTUM_TRADER=false
# DRY_RUN_MOMENTUM_TRADER=true            # paper-trade: real /quote, never /swap (own flag, NOT the arb bot's DRY_RUN)
# MOMENTUM_JUPITER_API_URL=https://lite-api.jup.ag/swap/v1   # Jupiter free public endpoint (no key); paths /quote + /swap
# MOMENTUM_TOKENS_PATH=assets/momentum_tokens.json       # hand-curated [{symbol, mint}] watch list
# MOMENTUM_TRADE_USDC=50.0                # fixed USDC notional per entry (applies per slot)
# MOMENTUM_MAX_POSITIONS=1               # max concurrent positions (slots). Default 1 = single-slot,
#                                         #   identical to the original trader (backward-compatible).
#                                         #   >1 enables multi-slot: fills free slots each tick, evicts
#                                         #   the weakest-green held when full (if ROTATE_MARGIN>0).
#                                         #   Per-token params in momentum_tokens.json override global
#                                         #   min_metric/trail_pct/max_run_pct per token.
#                                         #   ⚠  Paper-test first: DRY_RUN_MOMENTUM_TRADER=true, then
#                                         #      compare realized results before live multi-slot.
# MOMENTUM_TRAIL_PCT=8.0                  # exit when price ≤ peak·(1 − 8%)
# MOMENTUM_FADE_UNDERWATER_MAX_GAIN_PCT=  # extend MOMENTUM_EXIT_ON_FADE to an UNDERWATER position whose peak never
                                          #   exceeded this % above entry (it never proved itself). Unset = OFF (fade stays
                                          #   green-only). Fires on a MOMENTUM signal, not a price level, so a position still
                                          #   trending is never touched — unlike MOMENTUM_INITIAL_STOP_PCT.
                                          #   MEASURED: works mechanically (worst train trade −100.66 → −57.21) but LOSES
                                          #   out-of-sample at every setting (off +535, 0% +456, 1% +324, 2% +313, 5% +275)
                                          #   and PRE-EMPTS stagnation eviction entirely (4 evictions → 0), substituting a
                                          #   worse exit for a better one. Leave off. See CLAUDE.md.
# MOMENTUM_FADE_UNDERWATER_SCORE=         # own score bar for that arm; unset = the token's entry min_metric. A LOWER bar
                                          #   fires later/rarer to stop it pre-empting stagnation eviction. MEASURED: does
                                          #   not work. Held-out converges to the off-baseline FROM BELOW and never crosses
                                          #   it (bar 0 → +291, −10 → +461, −30 → +534.29 vs off +534.62) while STILL taking
                                          #   the eviction's position at a worse price (worst −22.06 vs −14.01). Leave off.
# MOMENTUM_INITIAL_STOP_PCT=0             # stop at −N% while a position has not proved itself; 0 = off (default).
                                          #   MEASURED HARMFUL — leave off. Held-out P&L falls monotonically:
                                          #   off +1237, 3% +1137, 5% +1116, 8% +1085. It cuts positions that recover.
# MOMENTUM_INITIAL_STOP_RELEASE_PCT=0     # gain above entry that RELEASES the stop to the trail; 0 = any tick (default).
                                          #   Exists because "any tick" is meaningless proof: a live JitoSOL entry ticked
                                          #   +0.03% and was exempted permanently, then rode the trail to −10.1%/−$100.66.
                                          #   A 2% release DOES catch that trade (−3.1% after 16h instead of −10.1% after
                                          #   55h, saving $69) — and still LOSES: the same rule cost $270 elsewhere in the
                                          #   slice, forced 31 extra round-trips at a 38% win rate, and pre-empted the
                                          #   stagnation exit entirely (4 evictions → 0), substituting a worse exit for a
                                          #   better one. Held-out: raising it is monotonically worse at every stop width.
                                          #   Kept for a future regime, not for use now.
# MOMENTUM_RANK_METRIC=sortino           # ranking metric: sortino | sharpe | slope_r2 | return
#                                          #   slope_r2 = Clenow annualized ln-price slope × R² (recommended for clean trends)
#                                          #   all four are logged side-by-side each tick; this picks the one that sorts + gates
#                                          #   ⚠ the two thresholds below are in the SELECTED metric's units — RECALIBRATE when you change this
# MOMENTUM_MIN_METRIC=0.5                 # min score to enter, in MOMENTUM_RANK_METRIC's units (sortino~0.5, slope_r2~1.0, return~0.01)
# MOMENTUM_MAX_RUN_PCT=6.0                # skip buying (entry OR rotation target) a token whose lookback window ran >this % AND is decelerating; 0 = off
# MOMENTUM_DECEL_LOOKBACK_MIN=10          # recent-window (min) for the deceleration check: big run skipped only if last-N-min slope < full-window slope; 0 = pure run cap (no decel check)
# MOMENTUM_CONFIRM_LAG_OBS=5              # confirmation guard: skip entry/rotation if the ranking metric is below its value N obs ago (trend rolling over); 0 = off
# MOMENTUM_ROTATE_MARGIN=0.5              # while holding, rotate only if another token's score beats the held one's by ≥ this (same units); 0 = off
# --- Stagnation eviction (opt-in; frees a slot from a FLAT position ROTATE_MARGIN cannot touch) ---
# Rotation refuses to sell anything at or below entry, the trail needs a giveback from a peak
# that never rose, and fade-exit needs green — so a flat underwater position holds its slot
# indefinitely. Measured on a 156d single-slot replay: two such positions consumed 26% of the
# window and blocked bigger moves than the whole replay realized. 96h/2% fires ~5x per 109d.
# It is a rare-trigger TAIL GUARD, not a P&L engine: the pathology occurred twice in the
# sample and was validated out-of-sample once. Aggressive values (24-48h, band 5-8%) fire
# often and LOST money out-of-sample. Paper-test first (DRY_RUN_MOMENTUM_TRADER=true).
# MOMENTUM_STAGNATION_HOURS=96             # hours without a new high before a held position may be evicted; 0 = off (default)
# MOMENTUM_STAGNATION_BAND_PCT=2           # max % below entry that still counts as FLAT (default 2). This is what keeps it
                                           #   from becoming a stop-loss — below the band the position is FALLING and the
                                           #   trail owns it. A time-only version cut a -16.9% position that finished +18.5%.
# MOMENTUM_STAGNATION_MARGIN=0             # score margin a challenger must beat the stalled position by; 0 = any strictly
                                           #   stronger candidate that also clears its own per-token entry bar
# MOMENTUM_EXIT_ON_FADE=true             # while holding & in profit, take profit to USDC once the metric fades ≤ MOMENTUM_MIN_METRIC (rotation takes precedence); false = price-only exits
# MOMENTUM_ADOPT_WALLET_POSITION=false   # at startup (live only), adopt watched wallet holdings ≥ half the trade size as positions
#                                         #   MAX_POSITIONS=1: adopts if exactly one qualifies; warns+skips if 2+ (ambiguous).
#                                         #   MAX_POSITIONS>1: adopts up to free capacity, sorted by USD value desc; no ambiguity.
#                                         #   entry/peak = current price (real cost basis unknown; PnL measured from adoption).
# MOMENTUM_LOOKBACK_OBS=1440              # 1-min snapshots for the entry Sortino (must be >120; 1440≈1d)
# MOMENTUM_STALE_MINUTES=20               # skip a token whose price hasn't moved >0.1% in N min (market closed/halted); 0 = off
# MOMENTUM_REGIME_OBS=0                   # regime-gate window (N obs); 0 = off. Used by both level and trend modes.
# MOMENTUM_REGIME_MODE=level              # off | level (SOL>MA) | trend (SOL slope_r2 clean-uptrend — regime momentum, backtest-preferred). Backtest with `momentum-sim regime-compare`.
# MOMENTUM_REGIME_TREND_MIN=0             # trend mode only: min SOL slope_r2 to count as risk-on (annualized slope×R²; tune via regime-compare)
#
# --- gRPC price feed (opt-in): price momentum tokens from on-chain pool state instead of REST ---
# MOMENTUM_GRPC_PRICING=false             # master switch. Off (default) = REST pricing only, unchanged behavior.
# MOMENTUM_GRPC_STALE_SECS=30             # a gRPC price older than this falls back to REST for that token.
#                                         # `0` = trust-until-changed: no TTL (an AMM price cannot move without
#                                         # an account write), gated by the REST divergence cross-check below.
#                                         # Requires GRPC_ENDPOINT (+ optional GRPC_TOKEN), and each watched token
#                                         # in momentum_tokens.json needs a "pool" (pubkey, must also exist in pools.json)
#                                         # and "quote" ("USDC" or "SOL"). Supported: raydium_amm_v4 (vaults) +
#                                         # Orca/Raydium-CLMM/Meteora-DLMM (state account). Meteora DAMM = not yet.
#                                         # Other DEX kinds log and fall back to REST.
#                                         # Verify wiring against the live endpoint: GRPC_PRICE_SMOKE=1 ./portfolio-watcher
#                                         #   (streams wired tokens, prints on-chain prices ~25s, exits).
# Opt-in REST divergence cross-check (only active when MOMENTUM_GRPC_STALE_SECS=0). Periodically
# REST-fetches an already-trusted gRPC-priced mint and compares; a divergence beyond the bps
# budget distrusts the mint back to REST until a fresh on-chain write or a later re-agreeing
# check. Covers a dead gRPC stream or a price that migrated to an unwatched venue.
# MOMENTUM_GRPC_XCHECK_SECS=300            # per-mint cross-check cadence; 0 disables the cross-check
# MOMENTUM_GRPC_XCHECK_BPS=100             # divergence budget (gRPC vs REST) before distrusting the mint
# Opt-in: entry price-freshness guard — skip an entry/rotation buy when the Jupiter /quote
# implied fill price (USD in / token out) diverges from the live gRPC price by more than this
# many bps; the ranking signal was computed from a price that's since moved. Only fires with a
# trusted gRPC price available (present, not distrusted, and — outside trust-until-changed mode —
# within MOMENTUM_GRPC_STALE_SECS); otherwise the guard is skipped, not the trade. 0 (default) =
# off, and the gRPC price isn't even fetched.
# MOMENTUM_ENTRY_DIVERGENCE_BPS=0
# Opt-in: local impact pre-gate. The gRPC ingestion task continuously estimates the price
# impact of a MOMENTUM_TRADE_USDC-sized buy from live pool state (CP + Whirlpool pools only —
# DLMM's quote model is pure-linear, no signal). When that estimate is fresh (<120s) and
# exceeds 2x MOMENTUM_MAX_COST_BPS, the candidate is skipped WITHOUT spending a Jupiter REST
# quote. The local model ignores routing, so only an obviously-doomed candidate (2x margin) is
# skipped this way; anything closer is left to the authoritative Jupiter quote's cost gate.
# false (default) = pre-gate never runs, behavior unchanged.
# MOMENTUM_LOCAL_IMPACT=false
# Opt-in: event-driven trailing-stop EXIT off the gRPC feed (requires MOMENTUM_GRPC_PRICING).
# Re-evaluates the stop the moment a held token's on-chain price updates, with a dwell-time
# wick-confirmation. Off (default) = REST fast-tick exit, unchanged. Exit-only. The 1s poll
# ticker is retained as a backstop. Paper-test first (DRY_RUN_MOMENTUM_TRADER=true).
# MOMENTUM_GRPC_EXIT=false
# MOMENTUM_STOP_CONFIRM_SECS=3            # price must stay below the stop this long before selling
# Opt-in: gRPC spike → FAST ENTRY (Approach B, latency accelerant). When a watched token's gRPC
# price jumps up past MOMENTUM_SPIKE_BPS within MOMENTUM_SPIKE_WINDOW_SECS, re-run the NORMAL
# validated entry decision for that mint immediately instead of waiting up to 60s for the slow
# tick. The spike wins latency, not the decision — every gate still applies (rank metric/
# MIN_METRIC/regime/over-extension/cost/divergence/capacity/cooldown/daily cap); a spike on a
# token that doesn't already qualify does NOT buy. Requires MOMENTUM_GRPC_PRICING. UN-BACKTESTABLE
# (sub-second spikes don't exist in the 1-min history) — validate live via shadow → paper → live;
# do NOT add these to the optimize-momentum-config grid.
# MOMENTUM_SPIKE_ENTRY=false              # master switch; off = no detector wired, arm never fires (unchanged)
# MOMENTUM_SPIKE_SHADOW=true              # log the would-be entry (local gates only), never quote/buy — set false to arm
# MOMENTUM_SPIKE_BPS=100                  # upward move (bps) over the window that counts as a spike
# MOMENTUM_SPIKE_WINDOW_SECS=5            # rolling window (secs) for the spike threshold
# MOMENTUM_SPIKE_REGIME_GATE=true         # spike still respects the SOL regime gate; false = enter regardless of regime
# MOMENTUM_ENTRY_DIP_OBS=0                # "both true" entry: also require the strong token oversold (z over N obs ≤ −DIP_Z) — buy the pullback, not the top; 0 = off (UNVALIDATED, paper only)
# MOMENTUM_ENTRY_DIP_Z=1.5               # oversold z threshold for the dip gate above
# MOMENTUM_POLL_SECS=1                    # held-token price-poll cadence for the trailing stop
# MOMENTUM_REENTRY_COOLDOWN_SECS=3600     # per-mint bench after an exit
# MOMENTUM_MAX_TRADES_PER_DAY=4           # daily entry cap
# MOMENTUM_MAX_COST_BPS=100               # reject entry if gas+slippage exceeds this
# MOMENTUM_MAX_LOSS_USDC=0                # circuit breaker: halt all trading once cumulative realized P&L hits -this USDC (0 = off)
# MOMENTUM_SLIPPAGE_BPS=50                # slippage tolerance sent to Jupiter (entries + first exit attempt)
# MOMENTUM_EXIT_SLIPPAGE_CAP_BPS=800      # exits self-escalate ×2 per revert (50→100→200→400→cap) so they always land
# MOMENTUM_ENTRY_SLIPPAGE_CAP_BPS=150     # entries self-escalate ×2 per revert but cap TIGHT (optional fill; don't chase a blowoff top)
# MOMENTUM_ENTRY_RETRY_SECS=0             # re-attempt a reverted entry this many secs later on the fast tick (escalated bps); 0 = wait for the next 60s tick
# Staged (TWAP) entry: split the entry notional into N sequential swaps, sleeping between them —
# trades price impact for gas (cost gate runs once, on tranche 1's quote, with gas charged per
# tranche). A tranche failure mid-ladder KEEPS the partial fill as the position and stops buying
# (no unwind/retry); tranche-1 failure is the normal revert/escalation path. Applies uniformly to
# slow-tick AND spike entries. CAUTION: the watcher is one task — each live tranche can stall exit
# checks for up to its ~45s confirm + the sleep, so keep steps small (2-5) and sleeps short
# (1-10s); steps are clamped to 10. Execution-level knobs: invisible to momentum-sim, do NOT add
# to the optimize-momentum-config grid.
# MOMENTUM_ENTRY_STEPS=                   # unset/0/1 = single-swap entry (default); N≥2 = N tranches (clamped to 10)
# MOMENTUM_ENTRY_STEP_SLEEP_SECS=1        # sleep between consecutive tranches (seconds)
# MOMENTUM_STATE_PATH=assets/momentum_state.json
# MOMENTUM_HALT_PATH=assets/momentum_halt.json
# MOMENTUM_ACTIONS_PATH=assets/momentum_actions.jsonl
# MOMENTUM_PNL_PATH=assets/momentum_pnl.json     # cumulative realized-P&L summary (rewritten each closed trade)

# ----- Live token discovery (momentum overlay; opt-in, default off) -----
# When the momentum trader is live, periodically run scripts/scan_tokens.js and feed the
# top-N (Birdeye top-volume ∩ Jupiter-verified, minus stables/wrapped, with vol+liq floors
# and a vol/liq ratio cap) into the momentum universe IN MEMORY. assets/momentum_tokens.json
# is never written by this path; the overlay is transient (replaced each scan, reset on restart).
# Honest caveat: a curation heuristic (broadens what's watched), not a momentum edge.
# MOMENTUM_SCAN_ENABLE=false
# MOMENTUM_SCAN_INTERVAL_SECS=3600               # ~hourly; floored to one 60s monitor tick
# MOMENTUM_SCAN_TOP_N=3
# MOMENTUM_SCAN_SCRIPT=scripts/scan_tokens.js
# Scanner filter thresholds (read by scan_tokens.js):
# SCAN_MIN_VOLUME=250000
# SCAN_MIN_LIQUIDITY=200000
# SCAN_MAX_RATIO=30                               # reject vol/liq above this (anti-wash)
# SCAN_MAX_PAGES=15                               # page Birdeye 50/req until vol < floor (top ~750); deeper = more mid-cap stocks
# SCAN_VERIFY_MAX=25                              # cap Jupiter verify calls (only the top-N are kept)

ENABLE_FLASH_LOAN=false
MARGINFI_ACCOUNT=<your-lending-account-pubkey>
MARGINFI_GROUP=4qp6Fx6tnZkY5Wropq9wUYgtFxXKwE6viZxFHg3rdAG5
MARGINFI_SOL_BANK=CCKtUs6Cgwo4aaQUmBPmyoApH2gUDErxNZCAntD6LYGh
MARGINFI_SOL_BANK_ORACLE=7UVimffxr9ow1uXYxsr4LHAcV58mLzhmwaeKvJ1pjLiE

# ── Jito bypass for thin flash loan cycles ─────────────────────────────────────
# Raw-RPC transport (WALLET-FUNDED cycles only — any base, SOL or USDC; requires
# ENABLE_FLASH_LOAN=false): thin 2-hop local cycles that fit ONE ≤1232-byte tx with
# ZERO lookup tables are sent via plain sendTransaction — no Jito tip, no auction,
# immune to the non-Jito-validator ProgramAccountNotFound failure (no ALT resolution
# needed). A native (SOL) base's wrap + WSOL-close instructions ride the same size
# probe, so eligibility stays per-cycle. Everything else keeps the Jito path. Watch
# the 10-min "RAW summary" line: an included-and-reverted raw tx PAYS base+priority
# fees (est_fee_burn), unlike a dropped bundle (free).
# Reminder for the USDC experiment: set the base-scaled thresholds explicitly —
# unset INPUT_BASE_UNITS defaults to 1000000000 = 1,000 USDC at 6dp!
# ENABLE_RAW_RPC=true
# DLMM bin-walk quote: off | shadow | live (default shadow). shadow keeps the
# haircut quote hot but logs "dlmm-shadow" walk-vs-haircut divergence lines per
# evaluated DLMM hop; live makes the real bin fill walk (streamed bin arrays +
# dynamic base+variable fee) THE quote wherever bin data exists.
# DLMM_BIN_QUOTE=shadow
# PumpSwap trading (Phase 2, DEFAULT OFF, NOT yet on-chain-verified — see
# docs/pumpswap-trading.md). Off = pump pools stay pricing-only (watcher unaffected).
# On = the arb registry loads them and builds buy/sell swaps — but requires two extra
# constants sourced on-chain (pumpswap_protocol_fee_recipient, pumpswap_fee_program) and
# a passing simulateTransaction gate first. Do NOT enable on real funds until then.
# ENABLE_PUMPSWAP_TRADING=true
# Base units reserved for the momentum trader sharing this wallet: excluded from arb
# input sizing AND subtracted from the P&L-halt threshold so momentum spends don't
# read as arb drawdown. 0 = no reservation.
# BASE_BALANCE_RESERVE_UNITS=0

# When BYPASS_JITO_BUNDLE=true + ENABLE_FLASH_LOAN=true: cycles at or below
# JITO_BUNDLE_THRESHOLD bps gross are sent directly via RPC using elevated CU
# priority fee as the bid instead of a Jito tip. Cycles above the threshold still
# use Jito (the tip is affordable and fast inclusion is valuable).
# Effect: thin cycles (e.g. 16 bps gross − 9 bps flash fee = 7 bps net) become
# profitable because CU priority fee (~0.0012 SOL) replaces a 99% Jito tip.
# BYPASS_JITO_BUNDLE=false
# JITO_BUNDLE_THRESHOLD=20       # bps; cycles at or below use direct RPC (default: 20)
# COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=1000000  # 1 lamport/CU — recommended for direct mode

# ── Address Lookup Table (required for versioned transactions) ─────────────────
# Create once with: cargo run --release --bin solana-mev -- --init-alt
# Addresses saved to alt.json. Each ALT holds max 256 accounts; multiple ALTs
# are created automatically when needed (comma-separated list).
# ALT_ADDRESSES=<addr1>,<addr2>   # use this for multiple ALTs
# ALT_ADDRESS=<addr>              # single ALT (backward compat)

# ── Jupiter v6 as an extra quote source (optional) ─────────────────────────────
# Adds Jupiter-aggregated edges to the graph alongside the on-chain DEXs. Requires
# the self-hosted Metis binary (jup-ag/metis-binary) running and serving /quote +
# /swap-instructions on JUPITER_API_URL — the bot does NOT start it. See CLAUDE.md
# "Running the Jupiter swap-api". Leave disabled if you aren't running the binary.
# ENABLE_JUPITER=false
# JUPITER_API_URL=http://127.0.0.1:8080
# JUPITER_BINARY_PATH=./metis-binary      # set → bot auto-launches Metis as a child (killed on exit);
                                          # unset → run Metis yourself at JUPITER_API_URL
# JUPITER_BINARY_KEY=your-metis-key       # REQUIRED to auto-launch — Metis --binary-key license key
                                          # from your provider (Triton/QuickNode/Jupiter). Secret.
# JUPITER_PAIRS_PATH=jupiter_pairs.json   # flat list of { "token_a", "token_b" }
# JUPITER_POLL_INTERVAL_MS=500            # how often the poller refreshes Jupiter edge rates
# JUPITER_PROBE_LAMPORTS=1000000000       # 1 SOL reference size for marginal-rate probing

# ── Pairs trader (market-neutral xStocks; paper by default) ──
ENABLE_PAIRS_TRADER=false
DRY_RUN_PAIRS_TRADER=true
PAIRS_PATH=assets/pairs.json
PAIRS_LOOKBACK_OBS=240
PAIRS_Z_ENTRY=2.0
PAIRS_Z_EXIT=0.5
PAIRS_Z_STOP=4.5
# Reversal-confirmation entry filter: enter only once |z| has shrunk vs N obs ago (the
# spread is turning back), not while still diverging — skips "catch a falling knife" entries.
# 0 = off. Backtest (NVDAx/SPYx) endorses ~5–10 (modest out-of-sample improvement).
# Per-pair override: add "entry_confirm_obs" to a pair in pairs.json.
PAIRS_ENTRY_CONFIRM_OBS=5
PAIRS_TRADE_USDC=50
PAIRS_REENTRY_COOLDOWN_SECS=3600
PAIRS_MAX_TRADES_PER_DAY=6
PAIRS_MAX_BORROW_APY_PCT=30
PAIRS_MIN_HEALTH_FACTOR=1.5
# Loss circuit breaker (USDC). When cumulative realized P&L ≤ −this, the trader writes the
# halt file and stops opening. 0 = disabled. LIVE only — paper losses never halt.
PAIRS_MAX_LOSS_USDC=0
PAIRS_SLIPPAGE_BPS=50
# klend-builder sidecar URL. Empty (default) = borrowability/APY/health preflight gate
# DISABLED (pure paper, pre-2c behavior). Set it to enforce the gate before opens — e.g.
# block shorting GOOGLx (0 borrow cap). Run the sidecar: cd klend-builder && npm start
# PAIRS_KLEND_SIDECAR_URL=http://127.0.0.1:8181
# Auto-launch the klend-builder sidecar at startup (mirrors the Jupiter Metis auto-launch)
# and stop it at exit. Set to the sidecar dir; requires `npm install` there first. When set,
# PAIRS_KLEND_SIDECAR_URL defaults to http://127.0.0.1:8181 if left unset. Unset = run it yourself.
# PAIRS_KLEND_BUILDER_DIR=./klend-builder
# Append-only JSONL audit trail — one line per pairs decision (heartbeat / open / close /
# every skip reason: cooldown, daily cap, halt, preflight). The ground truth for "why
# did/didn't this pair act this tick" (sibling of MOMENTUM_ACTIONS_PATH).
PAIRS_ACTIONS_PATH=assets/pairs_actions.jsonl
# Email on every position OPEN (paper too). true = on (default); needs SMTP_* + ALERT_EMAIL set.
PAIRS_NOTIFY_EMAIL=true

# ── Kamino liquidation DETECTION bot (Phase A — paper only, no submission) ──────────────
# Scans a Kamino lending market for near-/at-liquidation obligations, computes the real
# seize→USDC profit (live Jupiter impact), and logs opportunities. Makes ZERO on-chain
# writes. Reuses the shared klend-builder sidecar (PAIRS_KLEND_* above). Phase B adds the
# flash-loan + liquidate + Jito-submit path.
ENABLE_LIQUIDATION_BOT=false
DRY_RUN_LIQUIDATION_BOT=true
# Market to scan (default = Kamino xStocks market; Phase 0 recon found it active).
# LIQUIDATION_MARKET=5wJeMrUYECGq41fxRESKALVcHnNX26TAWy4W98yULsua
# Bulk scan is heavy — pace it slowly; the watcher calls the tick every 60s but it self-paces.
LIQUIDATION_SCAN_SECS=300
# Watch obligations below this health factor (1.0 = liquidatable now; >1.0 sees the pipeline forming).
LIQUIDATION_SCAN_MAX_HF=1.05
LIQUIDATION_CLOSE_FACTOR=0.5
# Assumed liquidation bonus % (Phase A estimate; Phase B reads the real per-reserve bonus).
LIQUIDATION_BONUS_PCT=5.0
LIQUIDATION_MIN_PROFIT_USD=1.0
# Flash-loan fee bps on the repay leg — 0 for paper detection; set for Phase B.
LIQUIDATION_FLASH_FEE_BPS=0
# klend sidecar URL (defaults to PAIRS_KLEND_SIDECAR_URL, then http://127.0.0.1:8181).
# LIQUIDATION_KLEND_SIDECAR_URL=http://127.0.0.1:8181
LIQUIDATION_STATE_PATH=assets/liquidation_state.json
LIQUIDATION_ACTIONS_PATH=assets/liquidation_actions.jsonl
# One summary email per scan that finds new profitable opportunities (paper too). true = on
# (default); needs SMTP_* + ALERT_EMAIL set.
LIQUIDATION_NOTIFY_EMAIL=true

# ── Dynamic arb pool discovery (scripts/arb_refresh_loop.sh; opt-in, run manually) ──
# Periodically re-scans for trending, security-screened tokens that form executable arb
# cycles, rewrites pools.json within a subscribed-account budget, extends the ALT, and
# SIGHUPs the bot to reload. See docs/superpowers/specs/2026-07-25-dynamic-arb-pool-discovery-design.md
ARB_ACCOUNT_BUDGET=200          # max subscribed accounts in the generated book (feed starves past ~200)
ARB_SCAN_INTERVAL_SECS=21600    # refresh cadence (~6h); restarts reset the LATENCY ring, so keep it coarse
ARB_SCAN_EVICT_MARGIN=1.25      # a challenger must beat an incumbent's activity by this factor to evict it
ARB_ACTIVITY_WINDOW_SECS=300    # on-chain activity-ranking window
ARB_REEXEC_DRAIN_SECS=30        # bounded wait for in-flight submissions before re-exec on SIGHUP
ARB_VOLATILITY_WEIGHT=1.0       # activity ranking = 24h volume × (1 + weight·min(|1h change|,200%)); 0 = pure volume
# Raw-RPC FOCUS mode — rebuild the arb book around the no-tip 2-hop USDC edge ONLY (see CLAUDE.md
# "Raw-RPC FOCUS mode"). Core shrinks to momentum pools + SOL/USDC/USDT hubs; the only tokens
# admitted are movers with ≥2 liquid USDC venues (USDC→X→USDC, the shape the raw path lands).
# Refuses to write a core-only book, so a rate-limited empty discovery scan is a safe no-op.
# Set false for the legacy general-arb book (majors + any cycle-closing discovery).
ARB_RAW_RPC_FOCUS=true
ARB_RAW_MIN_USDC_LIQ=50000      # per-USDC-venue liquidity floor (USD); BOTH 2-hop legs must clear it
ARB_MIN_SIDE_SHARE=0.05         # reject venues whose smaller side < this share of total value (one-sided DLMM husks pass the total-liq floor with an unfillable marker price; 0 = off)
ARB_RAW_RPC_BOOST=3.0           # activity multiplier for a raw-eligible token's USDC venues (wins budget slots)
# Arb-scoped discovery widening: ARB_SCAN_* reaches ONLY the arb scanner's scan_tokens
# child; the momentum watcher's hourly scan keeps the shared SCAN_*/MOMENTUM_SCAN_* values.
# Unset = inherit the momentum settings (no override).
# ARB_SCAN_SOURCE=volume          # volume = page top-volume list (free tier ≈ top-50); trending = top-20 feed
# ARB_SCAN_MIN_VOLUME=150000      # arb-only 24h volume floor (USD)
# ARB_SCAN_MIN_LIQUIDITY=200000   # arb-only liquidity floor (USD)
# ARB_SCAN_VERIFY_MAX=50          # arb-only cap on Jupiter verification calls
# ARB_SCAN_REQUIRE_JUP_VERIFY=false # arb-only: skip Jupiter's verified-token gate (and its
#                                   # top-holders audit). The on-chain trap screen (freeze
#                                   # authority / transfer hook / frozen state) still runs —
#                                   # atomic arb doesn't need Jupiter's curation signal.
# ARB_SCAN_RANK=volume            # arb-only ranking. IMPORTANT when the momentum scan uses
#                                   # rank=change: change-mode drops decliners/over-extended/
#                                   # null-change survivors (momentum entry heuristics) —
#                                   # arb is direction-agnostic, volume keeps them all.
# ARB_SCAN_MAX_PAGES=15           # arb-only tokenlist paging cap (volume source)
# ARB_SCAN_TRENDING_LIMIT=50      # arb-only trending row cap (trending source)