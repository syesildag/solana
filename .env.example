GRPC_ENDPOINT=https://your-yellowstone-endpoint:443
GRPC_TOKEN=your-x-token-here
WALLET_KEYPAIR_PATH=/Users/you/.config/solana/id.json
RPC_URL=https://api.mainnet-beta.solana.com
POOLS_CONFIG_PATH=pools.json

# Arbitrage parameters
MIN_PROFIT_LAMPORTS=10000
INPUT_SOL_LAMPORTS=100000000
SLIPPAGE_BPS=50
# Maximum price impact per hop in bps (100 = 1%). Rejects pools too small for the trade.
MAX_PRICE_IMPACT_BPS=100

# Jito tip: 0.0 = 0%, 0.5 = 50% of gross profit goes to tip
TIP_RATIO=0.51
MAX_TIP_LAMPORTS=1000000

# Reject cycles whose tip is below MIN_TIP_LAMPORTS (absolute, 0 = off).
# MIN_TIP_LAMPORTS=5000000

# Reject cycles whose tip is below tip_floor × this multiple (0.0 = off).
# Competition typically bids 2000–5000× the floor on active blocks.
# A value of 500 filters clearly uncompetitive cycles before any submission attempt.
# MIN_TIP_FLOOR_MULTIPLE=0.0

# Set to true to log bundles without submitting
DRY_RUN=true

# Set to true to skip pre-submission simulation and submit bundles directly to Jito.
# Reduces latency at the cost of occasionally paying base fees on failed bundles.
# DISABLE_SIMULATION=false

# Set to true to fund arb capital via a MarginFi flash loan (~9 bps fee) instead of
# the wallet balance. Allows running with minimal SOL — wallet still needs ~0.1 SOL
# for tx fees and Jito tips, but not for swap capital.
# When active, INPUT_SOL_LAMPORTS is ignored. The ternary search finds the
# slippage-optimal input within [0.001 SOL, FLASH_LOAN_MAX_INPUT_SOL_LAMPORTS].
# Requires MARGINFI_ACCOUNT, MARGINFI_SOL_BANK_ORACLE (group + bank have mainnet defaults).
# Strongly recommended: also set DISABLE_SIMULATION=true when flash loan is active.
# ENABLE_FLASH_LOAN=false
# FLASH_LOAN_MAX_INPUT_SOL_LAMPORTS=50000000000    # 50 SOL cap; ternary search finds true optimum within this
# MARGINFI_ACCOUNT=<your-marginfi-lending-account-pubkey>
# MARGINFI_GROUP=4qp6Fx6tnZkY5Wropq9wUYgtFxXKwE6viZxFHg3rdAG5
# MARGINFI_SOL_BANK=CCKtUs6Cgwo4aaQUmBPmyoApH2gUDErxNZCAntD6LYGh
# MARGINFI_SOL_BANK_ORACLE=<pyth-or-switchboard-sol-usd-feed-for-this-bank>

# tracing filter: info, debug, warn
RUST_LOG=solana_mev=info

# ── Portfolio watcher (run as: ./portfolio-watcher) ───────────
PORTFOLIO_PATH=assets/portfolio.json
HISTORY_PATH=assets/price_history.jsonl

# Birdeye API key (free signup at birdeye.so) — used to backfill price history on first run
BIRDEYE_API_KEY=your-birdeye-api-key

# Alert thresholds
ALERT_PCT_5M=3.0     # email if any asset moves ±3% in 5 minutes
ALERT_PCT_1H=10.0    # email if any asset moves ±10% in 1 hour
ALERT_COOLDOWN_MIN=30

# Recipient email for opportunity alerts
ALERT_EMAIL=you@example.com

# SMTP credentials (e.g. Gmail app password, smtp.gmail.com:587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com

# ── Momentum trader (portfolio-watcher; off by default) ────────────────────────
# Buys the strongest watched token (Sortino) with USDC, rides it, trail-stops back
# to USDC. Independent of the arb bot and of ENABLE_JUPITER — it uses the public
# Jupiter REST endpoint below and needs NO Metis binary. See docs/portfolio/momentum-trader.md.
# ENABLE_MOMENTUM_TRADER=false
# DRY_RUN_MOMENTUM_TRADER=true            # paper-trade: real /quote, never /swap (own flag, NOT the arb bot's DRY_RUN)
# MOMENTUM_JUPITER_API_URL=https://lite-api.jup.ag/swap/v1   # Jupiter free public endpoint (no key); paths /quote + /swap
# MOMENTUM_TOKENS_PATH=assets/momentum_tokens.json       # hand-curated [{symbol, mint}] watch list
# MOMENTUM_TRADE_USDC=50.0                # fixed USDC notional per entry
# MOMENTUM_TRAIL_PCT=8.0                  # exit when price ≤ peak·(1 − 8%)
# MOMENTUM_RANK_METRIC=sortino           # ranking metric: sortino | sharpe | slope_r2 | return
#                                          #   slope_r2 = Clenow annualized ln-price slope × R² (recommended for clean trends)
#                                          #   all four are logged side-by-side each tick; this picks the one that sorts + gates
#                                          #   ⚠ the two thresholds below are in the SELECTED metric's units — RECALIBRATE when you change this
# MOMENTUM_MIN_METRIC=0.5                 # min score to enter, in MOMENTUM_RANK_METRIC's units (sortino~0.5, slope_r2~1.0, return~0.01)
# MOMENTUM_MAX_RUN_PCT=6.0                # skip buying (entry OR rotation target) a token whose lookback window ran >this % AND is decelerating; 0 = off
# MOMENTUM_DECEL_LOOKBACK_MIN=10          # recent-window (min) for the deceleration check: big run skipped only if last-N-min slope < full-window slope; 0 = pure run cap (no decel check)
# MOMENTUM_CONFIRM_LAG_OBS=5              # confirmation guard: skip entry/rotation if the ranking metric is below its value N obs ago (trend rolling over); 0 = off
# MOMENTUM_ROTATE_MARGIN=0.5              # while holding, rotate only if another token's score beats the held one's by ≥ this (same units); 0 = off
# MOMENTUM_EXIT_ON_FADE=true             # while holding & in profit, take profit to USDC once the metric fades ≤ MOMENTUM_MIN_METRIC (rotation takes precedence); false = price-only exits
# MOMENTUM_ADOPT_WALLET_POSITION=false   # at startup, if FLAT (live) and the wallet holds exactly one watched token worth ≥ half the trade size, adopt it as the position (entry/peak=current price); ambiguous (2+) skipped; false = never
# MOMENTUM_LOOKBACK_OBS=1440              # 1-min snapshots for the entry Sortino (must be >120; 1440≈1d)
# MOMENTUM_STALE_MINUTES=20               # skip a token whose price hasn't moved >0.1% in N min (market closed/halted); 0 = off
# MOMENTUM_REGIME_OBS=0                   # block entries unless SOL is above its N-obs moving average (risk-on); 0 = off. Backtest with `momentum-sim run --regime-obs ...`
# MOMENTUM_ENTRY_DIP_OBS=0                # "both true" entry: also require the strong token oversold (z over N obs ≤ −DIP_Z) — buy the pullback, not the top; 0 = off (UNVALIDATED, paper only)
# MOMENTUM_ENTRY_DIP_Z=1.5               # oversold z threshold for the dip gate above
# MOMENTUM_POLL_SECS=1                    # held-token price-poll cadence for the trailing stop
# MOMENTUM_REENTRY_COOLDOWN_SECS=3600     # per-mint bench after an exit
# MOMENTUM_MAX_TRADES_PER_DAY=4           # daily entry cap
# MOMENTUM_MAX_COST_BPS=100               # reject entry if gas+slippage exceeds this
# MOMENTUM_MAX_LOSS_USDC=0                # circuit breaker: halt all trading once cumulative realized P&L hits -this USDC (0 = off)
# MOMENTUM_SLIPPAGE_BPS=50                # slippage tolerance sent to Jupiter (entries + first exit attempt)
# MOMENTUM_EXIT_SLIPPAGE_CAP_BPS=800      # exits self-escalate ×3 per revert (50→150→450→cap) so they always land
# MOMENTUM_ENTRY_SLIPPAGE_CAP_BPS=150     # entries self-escalate ×3 per revert but cap TIGHT (optional fill; don't chase a blowoff top)
# MOMENTUM_STATE_PATH=assets/momentum_state.json
# MOMENTUM_HALT_PATH=assets/momentum_halt.json
# MOMENTUM_ACTIONS_PATH=assets/momentum_actions.jsonl
# MOMENTUM_PNL_PATH=assets/momentum_pnl.json     # cumulative realized-P&L summary (rewritten each closed trade)

# ----- Live token discovery (momentum overlay; opt-in, default off) -----
# When the momentum trader is live, periodically run scripts/scan_tokens.js and feed the
# top-N (Birdeye top-volume ∩ Jupiter-verified, minus stables/wrapped, with vol+liq floors
# and a vol/liq ratio cap) into the momentum universe IN MEMORY. assets/momentum_tokens.json
# is never written by this path; the overlay is transient (replaced each scan, reset on restart).
# Honest caveat: a curation heuristic (broadens what's watched), not a momentum edge.
# MOMENTUM_SCAN_ENABLE=false
# MOMENTUM_SCAN_INTERVAL_SECS=3600               # ~hourly; floored to one 60s monitor tick
# MOMENTUM_SCAN_TOP_N=3
# MOMENTUM_SCAN_SCRIPT=scripts/scan_tokens.js
# Scanner filter thresholds (read by scan_tokens.js):
# SCAN_MIN_VOLUME=250000
# SCAN_MIN_LIQUIDITY=200000
# SCAN_MAX_RATIO=30                               # reject vol/liq above this (anti-wash)
# SCAN_MAX_PAGES=15                               # page Birdeye 50/req until vol < floor (top ~750); deeper = more mid-cap stocks
# SCAN_VERIFY_MAX=25                              # cap Jupiter verify calls (only the top-N are kept)

ENABLE_FLASH_LOAN=false
MARGINFI_ACCOUNT=<your-lending-account-pubkey>
MARGINFI_GROUP=4qp6Fx6tnZkY5Wropq9wUYgtFxXKwE6viZxFHg3rdAG5
MARGINFI_SOL_BANK=CCKtUs6Cgwo4aaQUmBPmyoApH2gUDErxNZCAntD6LYGh
MARGINFI_SOL_BANK_ORACLE=7UVimffxr9ow1uXYxsr4LHAcV58mLzhmwaeKvJ1pjLiE

# ── Jito bypass for thin flash loan cycles ─────────────────────────────────────
# When BYPASS_JITO_BUNDLE=true + ENABLE_FLASH_LOAN=true: cycles at or below
# JITO_BUNDLE_THRESHOLD bps gross are sent directly via RPC using elevated CU
# priority fee as the bid instead of a Jito tip. Cycles above the threshold still
# use Jito (the tip is affordable and fast inclusion is valuable).
# Effect: thin cycles (e.g. 16 bps gross − 9 bps flash fee = 7 bps net) become
# profitable because CU priority fee (~0.0012 SOL) replaces a 99% Jito tip.
# BYPASS_JITO_BUNDLE=false
# JITO_BUNDLE_THRESHOLD=20       # bps; cycles at or below use direct RPC (default: 20)
# COMPUTE_UNIT_PRICE_MICRO_LAMPORTS=1000000  # 1 lamport/CU — recommended for direct mode

# ── Address Lookup Table (required for versioned transactions) ─────────────────
# Create once with: cargo run --release --bin solana-mev -- --init-alt
# Addresses saved to alt.json. Each ALT holds max 256 accounts; multiple ALTs
# are created automatically when needed (comma-separated list).
# ALT_ADDRESSES=<addr1>,<addr2>   # use this for multiple ALTs
# ALT_ADDRESS=<addr>              # single ALT (backward compat)

# ── Jupiter v6 as an extra quote source (optional) ─────────────────────────────
# Adds Jupiter-aggregated edges to the graph alongside the on-chain DEXs. Requires
# the self-hosted Metis binary (jup-ag/metis-binary) running and serving /quote +
# /swap-instructions on JUPITER_API_URL — the bot does NOT start it. See CLAUDE.md
# "Running the Jupiter swap-api". Leave disabled if you aren't running the binary.
# ENABLE_JUPITER=false
# JUPITER_API_URL=http://127.0.0.1:8080
# JUPITER_BINARY_PATH=./metis-binary      # set → bot auto-launches Metis as a child (killed on exit);
                                          # unset → run Metis yourself at JUPITER_API_URL
# JUPITER_BINARY_KEY=your-metis-key       # REQUIRED to auto-launch — Metis --binary-key license key
                                          # from your provider (Triton/QuickNode/Jupiter). Secret.
# JUPITER_PAIRS_PATH=jupiter_pairs.json   # flat list of { "token_a", "token_b" }
# JUPITER_POLL_INTERVAL_MS=500            # how often the poller refreshes Jupiter edge rates
# JUPITER_PROBE_LAMPORTS=1000000000       # 1 SOL reference size for marginal-rate probing

# ── Pairs trader (market-neutral xStocks; paper by default) ──
ENABLE_PAIRS_TRADER=false
DRY_RUN_PAIRS_TRADER=true
PAIRS_PATH=assets/pairs.json
PAIRS_LOOKBACK_OBS=240
PAIRS_Z_ENTRY=2.0
PAIRS_Z_EXIT=0.5
PAIRS_Z_STOP=4.5
# Reversal-confirmation entry filter: enter only once |z| has shrunk vs N obs ago (the
# spread is turning back), not while still diverging — skips "catch a falling knife" entries.
# 0 = off. Backtest (NVDAx/SPYx) endorses ~5–10 (modest out-of-sample improvement).
# Per-pair override: add "entry_confirm_obs" to a pair in pairs.json.
PAIRS_ENTRY_CONFIRM_OBS=5
PAIRS_TRADE_USDC=50
PAIRS_REENTRY_COOLDOWN_SECS=3600
PAIRS_MAX_TRADES_PER_DAY=6
PAIRS_MAX_BORROW_APY_PCT=30
PAIRS_MIN_HEALTH_FACTOR=1.5
# Loss circuit breaker (USDC). When cumulative realized P&L ≤ −this, the trader writes the
# halt file and stops opening. 0 = disabled. LIVE only — paper losses never halt.
PAIRS_MAX_LOSS_USDC=0
PAIRS_SLIPPAGE_BPS=50
# klend-builder sidecar URL. Empty (default) = borrowability/APY/health preflight gate
# DISABLED (pure paper, pre-2c behavior). Set it to enforce the gate before opens — e.g.
# block shorting GOOGLx (0 borrow cap). Run the sidecar: cd klend-builder && npm start
# PAIRS_KLEND_SIDECAR_URL=http://127.0.0.1:8181
# Auto-launch the klend-builder sidecar at startup (mirrors the Jupiter Metis auto-launch)
# and stop it at exit. Set to the sidecar dir; requires `npm install` there first. When set,
# PAIRS_KLEND_SIDECAR_URL defaults to http://127.0.0.1:8181 if left unset. Unset = run it yourself.
# PAIRS_KLEND_BUILDER_DIR=./klend-builder
# Append-only JSONL audit trail — one line per pairs decision (heartbeat / open / close /
# every skip reason: cooldown, daily cap, halt, preflight). The ground truth for "why
# did/didn't this pair act this tick" (sibling of MOMENTUM_ACTIONS_PATH).
PAIRS_ACTIONS_PATH=assets/pairs_actions.jsonl
# Email on every position OPEN (paper too). true = on (default); needs SMTP_* + ALERT_EMAIL set.
PAIRS_NOTIFY_EMAIL=true

# ── Kamino liquidation DETECTION bot (Phase A — paper only, no submission) ──────────────
# Scans a Kamino lending market for near-/at-liquidation obligations, computes the real
# seize→USDC profit (live Jupiter impact), and logs opportunities. Makes ZERO on-chain
# writes. Reuses the shared klend-builder sidecar (PAIRS_KLEND_* above). Phase B adds the
# flash-loan + liquidate + Jito-submit path.
ENABLE_LIQUIDATION_BOT=false
DRY_RUN_LIQUIDATION_BOT=true
# Market to scan (default = Kamino xStocks market; Phase 0 recon found it active).
# LIQUIDATION_MARKET=5wJeMrUYECGq41fxRESKALVcHnNX26TAWy4W98yULsua
# Bulk scan is heavy — pace it slowly; the watcher calls the tick every 60s but it self-paces.
LIQUIDATION_SCAN_SECS=300
# Watch obligations below this health factor (1.0 = liquidatable now; >1.0 sees the pipeline forming).
LIQUIDATION_SCAN_MAX_HF=1.05
LIQUIDATION_CLOSE_FACTOR=0.5
# Assumed liquidation bonus % (Phase A estimate; Phase B reads the real per-reserve bonus).
LIQUIDATION_BONUS_PCT=5.0
LIQUIDATION_MIN_PROFIT_USD=1.0
# Flash-loan fee bps on the repay leg — 0 for paper detection; set for Phase B.
LIQUIDATION_FLASH_FEE_BPS=0
# klend sidecar URL (defaults to PAIRS_KLEND_SIDECAR_URL, then http://127.0.0.1:8181).
# LIQUIDATION_KLEND_SIDECAR_URL=http://127.0.0.1:8181
LIQUIDATION_STATE_PATH=assets/liquidation_state.json
LIQUIDATION_ACTIONS_PATH=assets/liquidation_actions.jsonl
# One summary email per scan that finds new profitable opportunities (paper too). true = on
# (default); needs SMTP_* + ALERT_EMAIL set.
LIQUIDATION_NOTIFY_EMAIL=true